{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(*-key.json)",
      "Read(*_key.json)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(//**/.env*)",
      "Read(//**/*.pem)",
      "Read(//**/.ssh/id_*)",
      "Read(//**/secrets/**)",
      "Read(//**/*credentials*)",
      "Read(//**/.docker/config.json)",
      "Bash(gcloud secrets versions access*)",
      "Bash(gcloud auth print-*)",
      "Bash(gh auth token*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(op read*)",
      "Bash(op item get*)",
      "Bash(vault read*)",
      "Bash(vault kv get*)",
      "Bash(kubectl get secret*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(git *push *--force*)",
      "Bash(git *push -f*)",
      "Bash(git *push * -f*)",
      "Bash(git *push * +*)",
      "Bash(git * --no-verify*)",
      "Bash(git *commit -n*)",
      "Bash(git *-c core.hooks*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(kill -9 -1)"
    ],
    "ask": [
      "Bash(gh pr merge * --admin*)",
      "Bash(rm -*r* /*)",
      "Bash(rm -*r* ~*)",
      "Bash(rm -*r* $HOME*)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud * add-iam-policy-binding*)",
      "Bash(gcloud iam *)",
      "Bash(gcloud *run *deploy*)",
      "Bash(gcloud *run *update*)",
      "Bash(*bin/release prod*)",
      "Bash(gcloud * remove-iam-policy-binding*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:master)"
    ]
  }
}
